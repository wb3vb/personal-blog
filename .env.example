# ---------------------------------------------------------------------------
# 이 파일은 "어떤 환경변수가 필요한지" 알려주는 견본이다. 실제 값은 넣지 않는다.
# 로컬에서 쓰려면 .env.local 로 복사한 뒤 값을 채운다 (.env* 는 git에 올라가지 않음).
#   cp .env.example .env.local
# 배포(Vercel)는 프로젝트 Settings > Environment Variables 에 같은 이름으로 등록한다.
# ---------------------------------------------------------------------------

# [1] GA4 측정 ID — 방문자 수집(사이트에 추적 코드를 심는다)
# 형식: G- 로 시작하는 10자 내외 문자열
# 위치: Google Analytics > 관리 > 데이터 스트림 > (웹 스트림) > 측정 ID
# 없으면 GA가 비활성화되고 조회수가 쌓이지 않는다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# [2] GA4 속성 ID — 조회수 읽기(서버가 인기글을 계산할 때 쓴다)
# 형식: 숫자만 (예: 123456789). 측정 ID(G-...)와 다른 값이다.
# 위치: Google Analytics > 관리 > 속성 설정 > 속성 ID
GA4_PROPERTY_ID=

# [3] 서비스 계정 키 — 조회수를 읽을 권한
# Google Cloud에서 만든 서비스 계정의 JSON 키 전체를 "한 줄"로 붙여넣는다.
# 줄바꿈이 들어가면 파싱에 실패하므로 개행은 \n 으로 이스케이프된 상태여야 한다.
# 예: {"type":"service_account","project_id":"...","private_key":"-----BEGIN...\n...","client_email":"...@....iam.gserviceaccount.com",...}
GOOGLE_APPLICATION_CREDENTIALS_JSON=
